#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Mohammadreza Khellat <mkhellat@beavernets.com>
# Run the header anatomy experiment.  See README.md.
#
# Formats a throwaway 32 MiB LUKS2 image file with cryptsetup's
# defaults (including Argon2id, which benchmarks for about 2 seconds
# and can use up to 1 GiB of RAM), shows luksDump and the parsed
# binary headers, then damages the primary header and shows how
# cryptsetup reacts.  Needs no root and touches no block device.
# Everything is deleted on exit.
set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

for tool in cryptsetup python3 truncate dd cmp; do
	command -v "$tool" >/dev/null 2>&1 || {
		echo "error: $tool is required" >&2
		exit 1
	}
done

work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT INT TERM

img=$work/test.img
pass=$work/passphrase
printf '%s' 'synthetic-test-passphrase' > "$pass"
truncate -s 32M "$img"

cryptsetup --version
cryptsetup luksFormat --type luks2 --batch-mode --key-file "$pass" "$img"

echo
echo "== cryptsetup luksDump (salt and UUID values elided) =="
cryptsetup luksDump "$img" |
	sed -e 's/\(Salt:[[:space:]]*\).*/\1<random>/' \
	    -e 's/^\([[:space:]]*\)\([0-9a-f][0-9a-f] \)\{8,\}.*$/\1<random>/' \
	    -e 's/\(UUID:[[:space:]]*\).*/\1<random>/' \
	    -e 's/\(Digest:[[:space:]]*\).*/\1<random>/'

echo
echo "== Parsed binary headers =="
python3 -I "$here/parse_headers.py" "$img"

# Damage the primary header: flip one byte inside its JSON area, which
# the checksum covers.
echo
echo "== Damage: flip one byte of the primary JSON area =="
cp "$img" "$work/before.img"
printf '\377' | dd of="$img" bs=1 seek=8192 conv=notrunc status=none
cp "$img" "$work/damaged.img"

# Run each command on its own fresh copy of the damaged image, then
# report whether it rewrote the primary header.
for cmd in luksDump repair; do
	cp "$work/damaged.img" "$work/$cmd.img"
	echo "-- cryptsetup $cmd on a fresh copy of the damaged image:"
	if [ "$cmd" = luksDump ]; then
		set -- cryptsetup luksDump "$work/$cmd.img"
	else
		set -- cryptsetup repair --batch-mode "$work/$cmd.img"
	fi
	if "$@" >/dev/null 2>"$work/err"; then
		echo "   $cmd exit status 0"
	else
		echo "   $cmd failed: $(cat "$work/err")"
	fi
	if [ -s "$work/err" ]; then
		echo "   stderr: $(cat "$work/err")"
	else
		echo "   nothing on stderr"
	fi
	if cmp -s -n 16384 "$work/$cmd.img" "$work/damaged.img"; then
		echo "   primary header: left damaged"
	else
		echo "   primary header: rewritten"
	fi
	if cmp -s -n 12288 -i 4096 "$work/$cmd.img" "$work/before.img"; then
		echo "   primary JSON area identical to before the damage"
	else
		echo "   primary JSON area differs from before the damage"
	fi
	python3 -I "$here/parse_headers.py" "$work/$cmd.img" |
		grep -E 'checksum valid|salt' | sed 's/^/  /'
done
