#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Mohammadreza Khellat <mkhellat@beavernets.com>
#
# inspect-keyslot - extract and hex-dump a LUKS2 keyslot's area (its
# encrypted, AF-split copy of the master key) directly from a device,
# with two rough visual damage heuristics. See
# docs/checking-for-corruption.md for the methodology and how to
# interpret the output.

set -eu

PROG="$(basename "$0")"
ZERO_RUN_THRESHOLD=32     # bytes; see usage note below on why this is a rough heuristic
PATTERN_REPEAT_THRESHOLD=6  # run of bytes each equal to the one 1-8 bytes earlier
HEAD_TAIL_BYTES=128

usage() {
    cat <<EOF
Usage: $PROG [--slot N] [--zero-threshold N] [--pattern-threshold N] /dev/sdX

Inspect a LUKS2 keyslot's area on disk: the keyslot's encrypted,
AF-split copy of the master key.

Dumps the head and tail of the area (via dd+xxd) and runs two rough
heuristic checks over all of it: long runs of zero bytes (zero-filled
regions) and short repeating patterns, 1-8 bytes wide (fill patterns,
e.g. a "deadbeef deadbeef ..." overwrite). Neither is a statistical
test - both are quick visual aids. See docs/checking-for-corruption.md
for what healthy and damaged areas look like and how to interpret the
output. cryptsetup repair also checks keyslot areas for low-entropy
damage and prints a warning when it finds some.

IMPORTANT LIMITATION: the area holds ciphertext, which looks like
random bytes. Damage that leaves random-looking bytes - flipped bits,
or a block overwritten with random data - looks exactly like intact
ciphertext, so neither these heuristics nor any other inspection of
the bytes can detect it, and LUKS2 keeps no checksum of keyslot areas.
Such damage still destroys the key (see
docs/af-splitting-explained.md); only damage that leaves non-random
bytes, such as zero fills or repeating patterns, can be seen.

Options:
  --slot N                Inspect keyslot N directly, skipping the prompt.
  --zero-threshold N       Flag zero-byte runs of at least N bytes as
                           suspicious (default: $ZERO_RUN_THRESHOLD).
  --pattern-threshold N    Flag a run of at least N consecutive bytes
                           that each equal the byte 1-8 positions
                           earlier, i.e. a repeating pattern of that
                           period (default: $PATTERN_REPEAT_THRESHOLD;
                           random data almost never reaches it in a
                           keyslot-sized area).
  -h, --help               Show this help and exit.

Needs read access to the device: root for a block device, none for
an image file of the device that you own.

Example:
  sudo $PROG /dev/sdX
  sudo $PROG --slot 0 /dev/sdX
  $PROG --slot 0 ./device.img
EOF
}

die() {
    echo "$PROG: error: $*" >&2
    exit 1
}

DEVICE=""
SLOT=""

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --slot)
            [ $# -ge 2 ] || die "--slot requires an argument"
            SLOT="$2"
            shift 2
            ;;
        --zero-threshold)
            [ $# -ge 2 ] || die "--zero-threshold requires an argument"
            ZERO_RUN_THRESHOLD="$2"
            shift 2
            ;;
        --pattern-threshold)
            [ $# -ge 2 ] || die "--pattern-threshold requires an argument"
            PATTERN_REPEAT_THRESHOLD="$2"
            shift 2
            ;;
        -*)
            die "unknown option: $1 (see --help)"
            ;;
        *)
            [ -z "$DEVICE" ] || die "unexpected extra argument: $1"
            DEVICE="$1"
            shift
            ;;
    esac
done

[ -n "$DEVICE" ] || { usage >&2; exit 1; }
[ -b "$DEVICE" ] || [ -f "$DEVICE" ] || die "$DEVICE is not a block device or file"

command -v cryptsetup >/dev/null 2>&1 || die "cryptsetup not found in PATH"
command -v xxd >/dev/null 2>&1 || die "xxd not found in PATH"

# luksDump and dd both need to read the device, so fail fast with a
# clear message rather than letting cryptsetup's permission error stand
# alone.
[ -r "$DEVICE" ] ||
    die "cannot read $DEVICE (a block device usually needs root)"

DUMP="$(cryptsetup luksDump "$DEVICE" 2>&1)" || die "cryptsetup luksDump failed:
$DUMP"

# Keyslot numbers appear as "  N: luks2" lines in luksDump output.
# POSIX-safe alternative to bash's `mapfile`: build a newline-separated
# list via a subshell/command substitution, then iterate with a
# temporary IFS-based read loop instead of an array.
AVAILABLE_SLOTS="$(printf '%s\n' "$DUMP" | grep -E '^[[:space:]]+[0-9]+: luks2' | \
    sed -E 's/^[[:space:]]+([0-9]+): luks2.*/\1/')"

[ -n "$AVAILABLE_SLOTS" ] || die "no luks2 keyslots found on $DEVICE"

AVAILABLE_SLOTS_LINE="$(printf '%s' "$AVAILABLE_SLOTS" | tr '\n' ' ')"

if [ -z "$SLOT" ]; then
    slot_count="$(printf '%s\n' "$AVAILABLE_SLOTS" | wc -l)"
    if [ "$slot_count" -eq 1 ]; then
        SLOT="$AVAILABLE_SLOTS"
    else
        echo "Multiple keyslots found: $AVAILABLE_SLOTS_LINE"
        printf 'Which keyslot to inspect? '
        read -r SLOT
    fi
fi

printf '%s\n' "$AVAILABLE_SLOTS" | grep -qx "$SLOT" || \
    die "keyslot $SLOT not found (available: $AVAILABLE_SLOTS_LINE)"

# Extract this slot's block from luksDump: from its "N: luks2" line up
# to (but not including) the next top-level keyslot line or section.
SLOT_BLOCK="$(printf '%s\n' "$DUMP" | awk -v slot="$SLOT" '
    /^  [0-9]+: luks2/ {
        n = $1; sub(":", "", n)
        if (in_block) exit
        if (n == slot) { in_block = 1 }
    }
    in_block { print }
')"

AREA_OFFSET="$(printf '%s\n' "$SLOT_BLOCK" | \
    sed -n 's/.*Area offset:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)"
AREA_LENGTH="$(printf '%s\n' "$SLOT_BLOCK" | \
    sed -n 's/.*Area length:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)"

[ -n "$AREA_OFFSET" ] && [ -n "$AREA_LENGTH" ] || \
    die "could not parse Area offset/length for keyslot $SLOT from luksDump output"

echo "Keyslot $SLOT: Area offset=$AREA_OFFSET bytes, Area length=$AREA_LENGTH bytes"
echo

RAW_HEX="$(dd if="$DEVICE" bs=1 skip="$AREA_OFFSET" count="$AREA_LENGTH" 2>/dev/null | xxd)"

echo "--- head (first $HEAD_TAIL_BYTES bytes) ---"
printf '%s\n' "$RAW_HEX" | head -n "$((HEAD_TAIL_BYTES / 16))"
echo
echo "--- tail (last $HEAD_TAIL_BYTES bytes) ---"
printf '%s\n' "$RAW_HEX" | tail -n "$((HEAD_TAIL_BYTES / 16))"
echo

# Both heuristics below read the same byte stream once (via a single
# `od` dump piped to awk) rather than re-reading the device twice.
#
# Rough heuristics only:
#  - longest run of the zero byte (zero-filled region)
#  - longest run of consecutive bytes each equal to the byte 1-8
#    positions earlier, i.e. a short repeating pattern (fill-pattern
#    overwrite, e.g. "deadbeef deadbeef ...")
# Real ciphertext produces short coincidental runs of either kind by
# chance; these are visual aids to catch gross zero-fill or pattern
# damage, not a statistical test, and they do NOT catch damage that
# leaves random-looking bytes (see the IMPORTANT LIMITATION note in
# --help). See docs/checking-for-corruption.md.
HEURISTIC_RESULT="$(dd if="$DEVICE" bs=1 skip="$AREA_OFFSET" count="$AREA_LENGTH" 2>/dev/null | \
    od -An -tu1 -v | tr -s ' ' '\n' | awk '
        NF { n++; b[n] = $0 }
        END {
            zero_max = 0
            run = 0
            for (i = 1; i <= n; i++) {
                if (b[i] == "0") { run++; if (run > zero_max) zero_max = run }
                else { run = 0 }
            }

            pattern_max = 0
            pattern_period = 0
            for (period = 1; period <= 8; period++) {
                run = 0
                for (i = period + 1; i <= n; i++) {
                    if (b[i] == b[i - period]) {
                        run++
                        if (run > pattern_max) { pattern_max = run; pattern_period = period }
                    } else {
                        run = 0
                    }
                }
            }

            print zero_max, pattern_max, pattern_period
        }
    ')"

LONGEST_ZERO_RUN="$(printf '%s' "$HEURISTIC_RESULT" | cut -d' ' -f1)"
LONGEST_PATTERN_RUN="$(printf '%s' "$HEURISTIC_RESULT" | cut -d' ' -f2)"
LONGEST_PATTERN_PERIOD="$(printf '%s' "$HEURISTIC_RESULT" | cut -d' ' -f3)"

echo "Longest zero-byte run in keyslot area: $LONGEST_ZERO_RUN bytes"
if [ "$LONGEST_ZERO_RUN" -ge "$ZERO_RUN_THRESHOLD" ]; then
    echo "NOTE: this exceeds the zero-run threshold ($ZERO_RUN_THRESHOLD bytes)."
    echo "      This is a rough visual flag, not a diagnosis - see"
    echo "      docs/checking-for-corruption.md for how to interpret it."
else
    echo "No suspiciously long zero-runs found (threshold: $ZERO_RUN_THRESHOLD bytes)."
fi

echo "Longest repeating-pattern run: $LONGEST_PATTERN_RUN bytes, each equal to the byte $LONGEST_PATTERN_PERIOD position(s) earlier"
if [ "$LONGEST_PATTERN_RUN" -ge "$PATTERN_REPEAT_THRESHOLD" ]; then
    echo "NOTE: this exceeds the pattern threshold ($PATTERN_REPEAT_THRESHOLD bytes)."
    echo "      A short pattern repeating this many times in a row is not"
    echo "      something real ciphertext produces by chance - see"
    echo "      docs/checking-for-corruption.md for how to interpret it."
else
    echo "No suspiciously long repeating patterns found (threshold: $PATTERN_REPEAT_THRESHOLD bytes)."
fi

echo
echo "Reminder: these are rough heuristics only. They cannot detect damage"
echo "that leaves random-looking bytes, such as flipped bits - see"
echo "docs/checking-for-corruption.md, 'What no inspection can detect'."
