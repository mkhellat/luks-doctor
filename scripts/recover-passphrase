#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Mohammadreza Khellat <mkhellat@beavernets.com>
#
# recover-passphrase - bounded edit-distance-1 search for a nearly-
# correct LUKS2 passphrase (one substitution, deletion, insertion,
# adjacent-character transposition, or case slip away from a known-good
# guess; inserting a letter is opt-in, see --insert-letters). Uses
# `cryptsetup open --test-passphrase`, which verifies without
# activating/mapping the device. See
# docs/passphrase-recovery.md for the methodology and why this is
# deliberately NOT a general password-cracking tool.

set -eu

PROG="$(basename "$0")"

DO_SUBSTITUTION=1
DO_DELETION=1
DO_INSERTION=1
DO_TRANSPOSITION=1
DO_CASE_FLIP=1
INSERT_LETTERS=0
INSERT_CHARS='0123456789!@#$%^&*_-.'
LAYOUT='qwerty'
EDIT_DISTANCE=1

usage() {
    cat <<EOF
Usage: $PROG [OPTIONS] /dev/sdX 'best-guess-passphrase'

Search for a working LUKS2 passphrase within edit distance 1 of a
known-good guess, using safe non-activating verification
(cryptsetup open --test-passphrase). Intended for the case where you
are highly confident of a passphrase but suspect exactly one typo'd,
dropped, extra, swapped, or wrong-case character (a missing letter is
only searched with --insert-letters). Not a general brute-force tool - see
docs/passphrase-recovery.md.

Options:
  --layout NAME          Physical keyboard layout for substitution
                          adjacency: qwerty (default), azerty, qwertz,
                          dvorak. Use whichever layout the passphrase
                          was actually typed on when the typo happened.
  --no-substitution      Skip keyboard-adjacency / shift-symbol substitution candidates.
  --no-deletion          Skip single-character deletion candidates.
  --no-insertion         Skip single-character insertion candidates.
  --no-transposition     Skip adjacent-character transposition candidates.
  --no-case-flip         Skip candidates that flip the case of one letter.
  --insert-chars STR     Character set to try inserting (default: $INSERT_CHARS).
  --insert-letters       Also try inserting each lowercase letter a-z
                          (appended to the insertion character set).
                          Off by default: it adds about 26 candidates
                          per position, and each test costs a full KDF
                          run (about 2 seconds with default Argon2id).
  --edit-distance N      Number of edits to combine: 1 (default) or 2.
                          Distance 2 applies two of the edits above and
                          the candidate count grows roughly as the
                          square of the distance-1 count (tens of
                          thousands for a typical passphrase), each a
                          full KDF run. Use the --no-* options and/or a
                          fast keyslot KDF to keep it tractable.
  -h, --help             Show this help and exit.

Needs read access to the device: root for a block device, none for
an image file of the device that you own.

Example:
  sudo $PROG --layout azerty /dev/sdX 'my-best-guess-passphrase'
  $PROG ./device.img 'my-best-guess-passphrase'
EOF
}

die() {
    echo "$PROG: error: $*" >&2
    exit 1
}

DEVICE=""
GUESS=""

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --no-substitution)
            DO_SUBSTITUTION=0
            shift
            ;;
        --no-deletion)
            DO_DELETION=0
            shift
            ;;
        --no-insertion)
            DO_INSERTION=0
            shift
            ;;
        --no-transposition)
            DO_TRANSPOSITION=0
            shift
            ;;
        --no-case-flip)
            DO_CASE_FLIP=0
            shift
            ;;
        --insert-letters)
            INSERT_LETTERS=1
            shift
            ;;
        --insert-chars)
            [ $# -ge 2 ] || die "--insert-chars requires an argument"
            INSERT_CHARS="$2"
            shift 2
            ;;
        --layout)
            [ $# -ge 2 ] || die "--layout requires an argument"
            LAYOUT="$2"
            shift 2
            ;;
        --edit-distance)
            [ $# -ge 2 ] || die "--edit-distance requires an argument"
            EDIT_DISTANCE="$2"
            shift 2
            ;;
        -*)
            die "unknown option: $1 (see --help)"
            ;;
        *)
            if [ -z "$DEVICE" ]; then
                DEVICE="$1"
            elif [ -z "$GUESS" ]; then
                GUESS="$1"
            else
                die "unexpected extra argument: $1"
            fi
            shift
            ;;
    esac
done

if [ -z "$DEVICE" ] || [ -z "$GUESS" ]; then
    usage >&2
    exit 1
fi
[ -b "$DEVICE" ] || [ -f "$DEVICE" ] || die "$DEVICE is not a block device or file"
command -v cryptsetup >/dev/null 2>&1 || die "cryptsetup not found in PATH"
case "$LAYOUT" in
    qwerty|azerty|qwertz|dvorak) ;;
    *) die "unknown --layout '$LAYOUT' (supported: qwerty, azerty, qwertz, dvorak)" ;;
esac
case "$EDIT_DISTANCE" in
    1|2) ;;
    *) die "unsupported --edit-distance '$EDIT_DISTANCE' (supported: 1, 2)" ;;
esac

[ -r "$DEVICE" ] ||
    die "cannot read $DEVICE (a block device usually needs root)"

# Adjacency reflects physical keyboard neighbors plus shift/symbol pairs
# sharing a key - these are the substitution slips a typing finger or a
# half-remembered passphrase actually produces, not a random character map.
# Dispatches on $LAYOUT to one of four per-layout tables below, since a
# physical typo on an AZERTY, QWERTZ or Dvorak keyboard lands on a
# different neighboring key than the same typo on QWERTY.
#
# POSIX-safe replacement for bash's `declare -A ADJACENT=(...)`: a
# case statement mapping each character to its adjacency string.
adjacent_chars_qwerty() {
    case "$1" in
        a) echo "qwsz" ;;
        b) echo "vghn" ;;
        c) echo "xdfv" ;;
        d) echo "serfcx" ;;
        e) echo "wsdr34" ;;
        f) echo "drtgvc" ;;
        g) echo "ftyhbv" ;;
        h) echo "gyujnb" ;;
        i) echo "ujko89" ;;
        j) echo "huikmn" ;;
        k) echo "jiolm" ;;
        l) echo "kop" ;;
        m) echo "njk" ;;
        n) echo "bhjm" ;;
        o) echo "iklp90" ;;
        p) echo "ol0" ;;
        q) echo "wa12" ;;
        r) echo "edft45" ;;
        s) echo "awedxz" ;;
        t) echo "rfgy56" ;;
        u) echo "yhji78" ;;
        v) echo "cfgb" ;;
        w) echo "qsae23" ;;
        x) echo "zsdc" ;;
        y) echo "tghu67" ;;
        z) echo "asx" ;;
        1) echo "q2" ;;
        2) echo "q1w3" ;;
        3) echo "w2e4" ;;
        4) echo "e3r5" ;;
        5) echo "r4t6" ;;
        6) echo "t5y7" ;;
        7) echo "y6u8" ;;
        8) echo "u7i9" ;;
        9) echo "i8o0" ;;
        0) echo "o9p" ;;
        *) echo "" ;;
    esac
}

# QWERTZ (German): physically identical to QWERTY except the Y and Z
# keys are swapped - every other key, including the whole number row,
# sits in the same place. Derived mechanically from the QWERTY table
# above by swapping y<->z everywhere (as a key and as a neighbor).
adjacent_chars_qwertz() {
    case "$1" in
        a) echo "qwsy" ;;
        b) echo "vghn" ;;
        c) echo "xdfv" ;;
        d) echo "serfcx" ;;
        e) echo "wsdr34" ;;
        f) echo "drtgvc" ;;
        g) echo "ftzhbv" ;;
        h) echo "gzujnb" ;;
        i) echo "ujko89" ;;
        j) echo "huikmn" ;;
        k) echo "jiolm" ;;
        l) echo "kop" ;;
        m) echo "njk" ;;
        n) echo "bhjm" ;;
        o) echo "iklp90" ;;
        p) echo "ol0" ;;
        q) echo "wa12" ;;
        r) echo "edft45" ;;
        s) echo "awedxy" ;;
        t) echo "rfgz56" ;;
        u) echo "zhji78" ;;
        v) echo "cfgb" ;;
        w) echo "qsae23" ;;
        x) echo "ysdc" ;;
        y) echo "asx" ;;
        z) echo "tghu67" ;;
        1) echo "q2" ;;
        2) echo "q1w3" ;;
        3) echo "w2e4" ;;
        4) echo "e3r5" ;;
        5) echo "r4t6" ;;
        6) echo "t5z7" ;;
        7) echo "z6u8" ;;
        8) echo "u7i9" ;;
        9) echo "i8o0" ;;
        0) echo "o9p" ;;
        *) echo "" ;;
    esac
}

# AZERTY (French): row1 is a-z-e-r-t-y-u-i-o-p (q<->a and w<->z swapped
# relative to QWERTY), row2 gains a trailing m (q-s-d-f-g-h-j-k-l-m), and
# row3 loses m and gains w at the front (w-x-c-v-b-n). Derived mechanically
# from the QWERTY table via the q<->a / w<->z swap, then hand-corrected
# for m's relocation from the end of row3 to the end of row2 (it now
# neighbors l/o/p instead of n/j/k).
adjacent_chars_azerty() {
    case "$1" in
        a) echo "zq12" ;;
        b) echo "vghn" ;;
        c) echo "xdfv" ;;
        d) echo "serfcx" ;;
        e) echo "zsdr34" ;;
        f) echo "drtgvc" ;;
        g) echo "ftyhbv" ;;
        h) echo "gyujnb" ;;
        i) echo "ujko89" ;;
        j) echo "huikn" ;;
        k) echo "jiol" ;;
        l) echo "kopm" ;;
        m) echo "lop" ;;
        n) echo "bhj" ;;
        o) echo "iklp90" ;;
        p) echo "ol0m" ;;
        q) echo "azsw" ;;
        r) echo "edft45" ;;
        s) echo "qzedxw" ;;
        t) echo "rfgy56" ;;
        u) echo "yhji78" ;;
        v) echo "cfgb" ;;
        w) echo "qsx" ;;
        x) echo "wsdc" ;;
        y) echo "tghu67" ;;
        z) echo "asqe23" ;;
        1) echo "a2" ;;
        2) echo "a1z3" ;;
        3) echo "z2e4" ;;
        4) echo "e3r5" ;;
        5) echo "r4t6" ;;
        6) echo "t5y7" ;;
        7) echo "y6u8" ;;
        8) echo "u7i9" ;;
        9) echo "i8o0" ;;
        0) echo "o9p" ;;
        *) echo "" ;;
    esac
}

# Dvorak (US Simplified): an ANSI keyboard with the letters rearranged,
# so each physical key slot sits where its QWERTY counterpart does but
# carries a different letter. The number row is identical to QWERTY.
# Layout (letter keys only shown):
#     top:     ' , . p y f g c r l /
#     home:    a o e u i d h t n s -
#     bottom:  ; q j k x b m w v z
# This table was derived by relabelling the QWERTY physical adjacency to
# the Dvorak legend and keeping each letter's letter/digit neighbours;
# experiments/keyboard-adjacency/ regenerates it from a coordinate model
# and checks that the same model reproduces the QWERTY and QWERTZ tables
# above exactly.
adjacent_chars_dvorak() {
    case "$1" in
        a) echo "o" ;;
        b) echo "xmdh" ;;
        c) echo "gr89ht" ;;
        d) echo "ihfgxb" ;;
        e) echo "oupqj" ;;
        f) echo "yg67id" ;;
        g) echo "fc78dh" ;;
        h) echo "dtgcbm" ;;
        i) echo "udyfkx" ;;
        j) echo "qkeu" ;;
        k) echo "jxui" ;;
        l) echo "r0ns" ;;
        m) echo "bwht" ;;
        n) echo "tsrlwv" ;;
        o) echo "aeq" ;;
        p) echo "y45eu" ;;
        q) echo "joe" ;;
        r) echo "cl90tn" ;;
        s) echo "nlvz" ;;
        t) echo "hncrmw" ;;
        u) echo "eipyjk" ;;
        v) echo "wzns" ;;
        w) echo "mvtn" ;;
        x) echo "kbid" ;;
        y) echo "pf56ui" ;;
        z) echo "vs" ;;
        *) echo "" ;;
    esac
}

adjacent_chars() {
    case "$LAYOUT" in
        azerty) adjacent_chars_azerty "$1" ;;
        qwertz) adjacent_chars_qwertz "$1" ;;
        dvorak) adjacent_chars_dvorak "$1" ;;
        *)      adjacent_chars_qwerty "$1" ;;
    esac
}

# POSIX-safe replacement for bash's `declare -A SHIFT_PAIR=(...)` plus
# the reverse-mapping loop that filled in both directions: a single
# case statement listing both directions explicitly. This table is the
# same across all layouts EXCEPT azerty, which additionally gets
# a few ASCII-safe digit<->symbol pairs appended below (azerty's number
# row types symbols unshifted and digits shifted - most of those symbols
# are accented/non-ASCII and are deliberately left out, since this tool
# only searches ASCII passphrase candidates).
shift_pair_common() {
    case "$1" in
        1) echo "!" ;;
        2) echo "@" ;;
        3) echo "#" ;;
        4) echo '$' ;;
        5) echo "%" ;;
        6) echo "^" ;;
        7) echo "&" ;;
        8) echo "*" ;;
        9) echo "(" ;;
        0) echo ")" ;;
        -) echo "_" ;;
        =) echo "+" ;;
        "'") echo '"' ;;
        ,) echo "<" ;;
        .) echo ">" ;;
        /) echo "?" ;;
        ";") echo ":" ;;
        "!") echo "1" ;;
        "@") echo "2" ;;
        "#") echo "3" ;;
        '$') echo "4" ;;
        "%") echo "5" ;;
        "^") echo "6" ;;
        "&") echo "7" ;;
        "*") echo "8" ;;
        "(") echo "9" ;;
        ")") echo "0" ;;
        _) echo "-" ;;
        +) echo "=" ;;
        '"') echo "'" ;;
        "<") echo "," ;;
        ">") echo "." ;;
        "?") echo "/" ;;
        ":") echo ";" ;;
        *) echo "" ;;
    esac
}

# ASCII-safe subset of AZERTY's unshifted-symbol/shifted-digit number
# row: 1<->& (key 1), 4<->' (key 4), 5<->( (key 5). The remaining keys
# on that row (2, 3, 6, 7, 8, 9, 0) unshift to accented or non-ASCII
# characters (e, ", -, e-grave, _, c-cedilla, a-grave) and are skipped.
shift_pair_azerty_extra() {
    case "$1" in
        1) echo "&" ;;
        "&") echo "1" ;;
        4) echo "'" ;;
        "'") echo "4" ;;
        5) echo "(" ;;
        "(") echo "5" ;;
        *) echo "" ;;
    esac
}

shift_pair() {
    common="$(shift_pair_common "$1")"
    if [ "$LAYOUT" = "azerty" ]; then
        extra="$(shift_pair_azerty_extra "$1")"
        printf '%s%s' "$common" "$extra"
    else
        printf '%s' "$common"
    fi
}

# to_upper CHAR / to_lower CHAR -> the other case of a single ASCII
# letter; any other character is printed unchanged. The letter's
# position in one alphabet string is looked up in the other, which
# keeps this independent of the locale (unlike tr ranges).
# Letters are matched with explicit lists below, not [a-z]/[A-Z]
# ranges: POSIX leaves bracket ranges unspecified outside the C
# locale, and some locales collate upper and lower case together.
LOWER_ALPHA='abcdefghijklmnopqrstuvwxyz'
UPPER_ALPHA='ABCDEFGHIJKLMNOPQRSTUVWXYZ'

to_upper() {
    case "$1" in
        [abcdefghijklmnopqrstuvwxyz])
            _head="${LOWER_ALPHA%%"$1"*}"
            char_at "$UPPER_ALPHA" "${#_head}"
            ;;
        *) printf '%s' "$1" ;;
    esac
}

to_lower() {
    case "$1" in
        [ABCDEFGHIJKLMNOPQRSTUVWXYZ])
            _head="${UPPER_ALPHA%%"$1"*}"
            char_at "$LOWER_ALPHA" "${#_head}"
            ;;
        *) printf '%s' "$1" ;;
    esac
}

# shifted_neighbours CHAR -> what a finger holding Shift types when it
# slips from the uppercase letter CHAR to a neighbouring key: the
# neighbours of its lowercase form, with letters in uppercase and
# number-row keys as the character that row types with Shift (the
# shift_pair symbol, except on AZERTY where Shift gives the number).
shifted_neighbours() {
    _lower="$(to_lower "$1")"
    _adj="$(adjacent_chars "$_lower")"
    _adjlen=${#_adj}
    _out=""
    _k=0
    while [ "$_k" -lt "$_adjlen" ]; do
        _n="$(char_at "$_adj" "$_k")"
        case "$_n" in
            [0123456789])
                if [ "$LAYOUT" = "azerty" ]; then
                    _out="${_out}${_n}"
                else
                    _out="${_out}$(shift_pair_common "$_n")"
                fi
                ;;
            *)
                _out="${_out}$(to_upper "$_n")"
                ;;
        esac
        _k=$((_k + 1))
    done
    printf '%s' "$_out"
}

# POSIX-safe substring helpers, replacing bash's ${var:offset:length}.
# Positions are 0-based on input/output to match the original bash
# indexing; internally these convert to `cut -c`'s 1-based, inclusive
# ranges.

# char_at STR POS -> single character at 0-based POS (empty if out of range)
char_at() {
    _s="$1"
    _pos="$2"
    printf '%s' "$_s" | cut -c "$((_pos + 1))"
}

# substr_from STR POS -> substring from 0-based POS to end
substr_from() {
    _s="$1"
    _pos="$2"
    if [ "$_pos" -lt "${#_s}" ]; then
        printf '%s' "$_s" | cut -c "$((_pos + 1))-"
    else
        printf ''
    fi
}

# substr_range STR START END -> substring covering 0-based [START, END)
# (i.e. bash's ${STR:START:END-START}); empty if the range is empty.
substr_range() {
    _s="$1"
    _start="$2"
    _end="$3"
    if [ "$_end" -le "$_start" ]; then
        printf ''
    else
        printf '%s' "$_s" | cut -c "$((_start + 1))-${_end}"
    fi
}

# POSIX sh has no arrays, so candidates and their labels are accumulated
# as newline-delimited records ("candidate<TAB>label") in a temp file
# instead of bash's CANDIDATES=()/LABELS=() arrays. This is cleaned up
# on exit via a trap.
CAND_FILE="$(mktemp)"
trap 'rm -f "$CAND_FILE" "$CAND_FILE.uniq" "$CAND_FILE.l1"' EXIT INT TERM

add_candidate() {
    printf '%s\t%s\n' "$1" "$2" >>"$CAND_FILE"
}

# --insert-letters extends the insertion set once, here, rather than
# inside the generator (which may run thousands of times for
# --edit-distance 2), so the letters are appended exactly once
# regardless of option order.
if [ "$DO_INSERTION" -eq 1 ] && [ "$INSERT_LETTERS" -eq 1 ]; then
    INSERT_CHARS="${INSERT_CHARS}${LOWER_ALPHA}"
fi
insert_len=${#INSERT_CHARS}

# generate_edits BASE SUFFIX -- append every enabled single-character
# edit of BASE to CAND_FILE, with SUFFIX added to each candidate's label
# (empty for the first edit, " (2nd edit)" for the second pass). This is
# the whole distance-1 search; --edit-distance 2 runs it again over each
# distance-1 candidate. Underscore-prefixed locals avoid clobbering the
# distance-2 driver's loop variable.
generate_edits() {
    _base="$1"
    _sfx="$2"
    _blen=${#_base}

    if [ "$DO_SUBSTITUTION" -eq 1 ]; then
        _i=0
        while [ "$_i" -lt "$_blen" ]; do
            _ch="$(char_at "$_base" "$_i")"
            case "$_ch" in
                [ABCDEFGHIJKLMNOPQRSTUVWXYZ]) _repl="$(shifted_neighbours "$_ch")$(shift_pair "$_ch")" ;;
                *)     _repl="$(adjacent_chars "$_ch")$(shift_pair "$_ch")" ;;
            esac
            _replen=${#_repl}
            _j=0
            while [ "$_j" -lt "$_replen" ]; do
                _rc="$(char_at "$_repl" "$_j")"
                _cand="$(substr_range "$_base" 0 "$_i")${_rc}$(substr_from "$_base" $((_i + 1)))"
                add_candidate "$_cand" "substitution, pos $_i$_sfx"
                _j=$((_j + 1))
            done
            _i=$((_i + 1))
        done
    fi

    if [ "$DO_DELETION" -eq 1 ]; then
        _i=0
        while [ "$_i" -lt "$_blen" ]; do
            _cand="$(substr_range "$_base" 0 "$_i")$(substr_from "$_base" $((_i + 1)))"
            add_candidate "$_cand" "deletion, pos $_i$_sfx"
            _i=$((_i + 1))
        done
    fi

    if [ "$DO_INSERTION" -eq 1 ]; then
        _i=0
        while [ "$_i" -le "$_blen" ]; do
            _j=0
            while [ "$_j" -lt "$insert_len" ]; do
                _ic="$(char_at "$INSERT_CHARS" "$_j")"
                _cand="$(substr_range "$_base" 0 "$_i")${_ic}$(substr_from "$_base" "$_i")"
                add_candidate "$_cand" "insertion, pos $_i$_sfx"
                _j=$((_j + 1))
            done
            _i=$((_i + 1))
        done
    fi

    # Transposition swaps the characters at 0-based positions i and i+1.
    # Swapping two equal characters gives back the base, so skip those.
    if [ "$DO_TRANSPOSITION" -eq 1 ]; then
        _i=0
        while [ "$((_i + 1))" -lt "$_blen" ]; do
            _c1="$(char_at "$_base" "$_i")"
            _c2="$(char_at "$_base" $((_i + 1)))"
            if [ "$_c1" != "$_c2" ]; then
                _cand="$(substr_range "$_base" 0 "$_i")${_c2}${_c1}$(substr_from "$_base" $((_i + 2)))"
                add_candidate "$_cand" "transposition, pos $_i$_sfx"
            fi
            _i=$((_i + 1))
        done
    fi

    # Case flip changes the case of one ASCII letter (a Shift or Caps
    # Lock slip). Other characters have no case and are skipped.
    if [ "$DO_CASE_FLIP" -eq 1 ]; then
        _i=0
        while [ "$_i" -lt "$_blen" ]; do
            _ch="$(char_at "$_base" "$_i")"
            case "$_ch" in
                [abcdefghijklmnopqrstuvwxyz]) _flipped="$(to_upper "$_ch")" ;;
                [ABCDEFGHIJKLMNOPQRSTUVWXYZ]) _flipped="$(to_lower "$_ch")" ;;
                *)     _flipped="" ;;
            esac
            if [ -n "$_flipped" ]; then
                _cand="$(substr_range "$_base" 0 "$_i")${_flipped}$(substr_from "$_base" $((_i + 1)))"
                add_candidate "$_cand" "case flip, pos $_i$_sfx"
            fi
            _i=$((_i + 1))
        done
    fi
}

# Distance 1: every single edit of the guess.
generate_edits "$GUESS" ""

# Distance 2: every single edit of each distinct distance-1 candidate.
# The distance-1 candidates above are the bases for the second edit;
# dedup them first so each base is expanded only once.
if [ "$EDIT_DISTANCE" -ge 2 ]; then
    cut -f1 "$CAND_FILE" | sort -u >"$CAND_FILE.l1"
    while IFS= read -r _b1; do
        generate_edits "$_b1" " (2nd edit)"
    done <"$CAND_FILE.l1"
    rm -f "$CAND_FILE.l1"
fi

# Different edits can produce the same string (deleting either 'l' of
# "ll", for example), and distance 2 collides heavily. Each test costs a
# full KDF run, so keep only the first occurrence of each candidate.
awk -F '\t' '!seen[$1]++' "$CAND_FILE" >"$CAND_FILE.uniq"
mv "$CAND_FILE.uniq" "$CAND_FILE"

total="$( [ -s "$CAND_FILE" ] && wc -l <"$CAND_FILE" || echo 0 )"
[ "$total" -gt 0 ] || die "no candidates generated (all edit operations disabled?)"

cryptsetup isLuks "$DEVICE" 2>/dev/null ||
    die "$DEVICE is not a LUKS device (or cannot be read)"

echo "luks-doctor: testing keyslot(s) on $DEVICE"
echo "luks-doctor: base guess: $GUESS"
if [ "$EDIT_DISTANCE" -ge 2 ]; then
    echo "luks-doctor: generated $total candidates at edit distance 2 (two of: substitution, deletion, insertion, transposition, case flip)"
    _est_s=$((total * 2))
    if [ "$_est_s" -ge 3600 ]; then
        _est="about $((_est_s / 3600)) h $(( (_est_s % 3600) / 60 )) min"
    else
        _est="about $((_est_s / 60)) min"
    fi
    echo "luks-doctor: WARNING: this is a large search. At ~2 s per guess (cryptsetup's default Argon2id) it would take $_est; far less with a pbkdf2 keyslot. Each test is a full KDF run - narrow it with the --no-* options if you can."
else
    echo "luks-doctor: generated $total candidates (substitution + deletion + insertion + transposition + case flip)"
fi

# Test one candidate. Returns 0 if it unlocks a keyslot and 1 if
# cryptsetup reports a wrong passphrase (exit status 2, "no permission
# (bad passphrase)" in cryptsetup(8) RETURN CODES). Any other failure
# would make every remaining candidate fail too and look like "no
# match", so stop and show cryptsetup's message instead.
test_passphrase() {
    set +e
    _err="$(printf '%s' "$1" | cryptsetup open --test-passphrase "$DEVICE" 2>&1 >/dev/null)"
    _status=$?
    set -e
    case "$_status" in
        0) return 0 ;;
        2) return 1 ;;
        *) echo
           die "cryptsetup failed with exit status $_status: $_err" ;;
    esac
}

printf 'luks-doctor: testing the base guess itself... '
if test_passphrase "$GUESS"; then
    echo "MATCH"
    echo
    echo "luks-doctor: the base guess unlocks a keyslot as it is, so the"
    echo "luks-doctor: passphrase is not the problem. If the volume still"
    echo "luks-doctor: does not open, see docs/checking-for-corruption.md."
    exit 0
fi
echo "no match"

found=0
n=0
while IFS="$(printf '\t')" read -r candidate label; do
    n=$((n + 1))
    printf 'luks-doctor: [%d/%d] testing candidate (%s)... ' "$n" "$total" "$label"
    if test_passphrase "$candidate"; then
        echo "MATCH"
        echo
        echo "luks-doctor: recovered passphrase:"
        echo "  $GUESS   (original guess, for reference)"
        echo "  $candidate    (working passphrase - $label)"
        echo
        echo "luks-doctor: SECURITY REMINDER"
        echo "  This passphrase is now confirmed and was found via automated search."
        echo "  You should:"
        echo "    1. Unlock the volume normally and mount it to confirm data access."
        echo "    2. Add a new keyslot with a passphrase you're confident you can type"
        echo "       reliably: cryptsetup luksAddKey $DEVICE"
        echo "    3. Once confirmed working, consider removing the old/typo-prone"
        echo "       keyslot: cryptsetup luksKillSlot $DEVICE <slot>"
        echo "  Treat any passphrase that was ever tested in bulk, or written to a"
        echo "  terminal/log, as lower-confidence going forward - rotate it if this"
        echo "  volume protects anything sensitive."
        found=1
        break
    else
        echo "no match"
    fi
done <"$CAND_FILE"

if [ "$found" -eq 0 ]; then
    echo
    echo "luks-doctor: no match found among $total edit-distance-1 candidates."
    echo "luks-doctor: the passphrase may differ by more than one edit, or the"
    echo "luks-doctor: base guess may be further off than assumed. See the Roadmap"
    echo "luks-doctor: in README.md for approaches not yet implemented here."
    exit 1
fi
